# Sao chép thành .env trước khi chạy: cp .env.example .env
POSTGRES_USER=ibanking
POSTGRES_PASSWORD=ibanking
POSTGRES_DB=postgres

# Bí mật ký JWT và token cho lời gọi service-to-service.
JWT_SECRET=tdtu-soa-midterm-jwt-secret
JWT_EXPIRES_MIN=60
INTERNAL_TOKEN=tdtu-soa-internal-token
OTP_PEPPER=tdtu-soa-otp-pepper

# OTP: 300 giây = 5 phút theo yêu cầu đề bài.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Thời gian giữ khoá dòng, chỉ để demo concurrency cho dễ quan sát.
# Đặt 0 nếu muốn đo hiệu năng thật.
LOCK_HOLD_MS=150

# SMTP: mặc định trỏ tới MailHog trong docker-compose (không cần tài khoản).
# Đổi sang SMTP thật thì điền SMTP_USER/SMTP_PASSWORD.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ibanking.tdtu.edu.vn
